# Server Environment
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api/v1
CLIENT_ORIGIN=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/pyq_insight

# Security & Authentication
JWT_ACCESS_SECRET=replace_with_super_secure_random_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_super_secure_random_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_cookie_secret_string

# Machine Learning Service (FastAPI)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=internal_pyq_insight_ml_secret_key

# File Storage
UPLOAD_STORAGE_TYPE=local
UPLOAD_LOCAL_DIR=./uploads/papers
MAX_FILE_SIZE_MB=15
MAX_PAGE_COUNT=25

# Background Processing
MAX_JOB_ATTEMPTS=3
JOB_LOCK_TIMEOUT_MS=300000
JOB_POLL_INTERVAL_MS=3000

# Frontend Next.js Public Vars
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_NAME="PYQ Insight"
