{
  "name": "pyq-insight-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "PYQ Insight: Academic Exam Intelligence Platform for AKTU",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @pyq/api dev",
    "dev:web": "pnpm --filter @pyq/web dev",
    "dev:ml": "cd apps/ml && ./venv/bin/uvicorn main:app --reload --port 8000"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "prettier": "^3.3.3"
  },
  "packageManager": "pnpm@11.12.0"
}
